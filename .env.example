# Valio API key; leave empty until configured.
VALIO_API_KEY=
# Valio API base URL.
VALIO_BASE_URL=
# Gemini API key; leave empty until configured.
GEMINI_API_KEY=
# Gemini model identifier.
GEMINI_MODEL=
# Expansion model identifier; empty uses GEMINI_MODEL.
GEMINI_EXPANSION_MODEL=
# Store backend: memory, file or postgres.
STORE=file
# PostgreSQL connection URL; leave empty until configured.
DATABASE_URL=
# Allowed web origins, separated by commas.
WEB_ORIGIN=http://localhost:3000
