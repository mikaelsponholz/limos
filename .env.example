# Valio API key; leave empty until configured.
VALIO_API_KEY=
# Valio API base URL.
VALIO_BASE_URL=
# Gemini API key; leave empty until configured.
GEMINI_API_KEY=
# Gemini model identifier (current Flash, checked with scripts/list_models.py).
GEMINI_MODEL=gemini-3.8-flash
# Expansion model identifier; empty uses GEMINI_MODEL. Phase 3 tests a Pro-class model here.
GEMINI_EXPANSION_MODEL=
# Store backend: memory, file or postgres.
STORE=file
# Local slim catalogue file; routes report unavailable when it is missing.
CATALOG_PATH=data/valio/catalog.slim.json
# PostgreSQL connection URL; leave empty until configured.
DATABASE_URL=
# Allowed web origins, separated by commas.
WEB_ORIGIN=http://localhost:3000
